# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/factcheck_rag

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Tavily (web search / evidence retrieval)
TAVILY_API_KEY=your_tavily_api_key_here

# ChromaDB (vector DB for Phase 2 curated knowledge base)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=curated_evidence

# Embeddings (Gemini embedding model, used for ChromaDB)
GEMINI_EMBEDDING_MODEL=text-embedding-004
